# Browser Google Drive picker (safe to expose; restrict by HTTP referrer / JS origin).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# Optional. Defaults to the numeric prefix of the client ID.
VITE_GOOGLE_APP_ID=
# Cloud Run extractor. Required for From Google Drive. Do not download ZIPs in the browser.
VITE_EXTRACT_API_URL=
